{
  "name": "web-property",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-property/src",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --config apps/web-property/vite.config.ts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build --config apps/web-property/vite.config.ts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/web-property/tsconfig.app.json --noEmit" }
    }
  }
}
